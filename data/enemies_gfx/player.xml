<Sprite 
	filename="data/enemies_gfx/player.png" 
	hotspots_filename="data/enemies_gfx/player_hotspots.png" 
	offset_x="9.5" 
	offset_y="8" 
	default_animation="idle"
	>

	<RectAnimation 
		frame_count="4" 
		frame_height="16" 
		frame_wait="0.1" 
		frame_width="19" 
		frames_per_row="4" 
		
		name="idle" 
		pos_x="0" 
		pos_y="0" >
	</RectAnimation>


	<RectAnimation 
		frame_count="1" 
		frame_height="16" 
		frame_wait="0.1" 
		frame_width="19" 
		frames_per_row="1" 
		
		name="off" 
		pos_x="0" 
		pos_y="0" >
	</RectAnimation>


	<RectAnimation 
		frame_count="4" 
		frame_height="16" 
		frame_wait="0.1" 
		frame_width="19" 
		frames_per_row="4" 
		
		pos_x="0" 
		pos_y="0" 
		name="throw"
		loop="0"
		next_animation="idle">

		<Event 
			check_physics_material="1" 
			frame="2" 
			max_distance="500" 
			name="throw_release" 
			on_finished="0" 
			probability="1" >

		</Event>

		<Event 
			check_physics_material="0" 
			frame="2" 
			max_distance="500" 
			name="sprite_invisible" 
			on_finished="0" 
			probability="1" >

		</Event>

		<Event 
			check_physics_material="0" 
			frame="3" 
			max_distance="500" 
			name="sprite_invisible" 
			on_finished="0" 
			probability="1" >

		</Event>

		<Event 
			check_physics_material="0" 
			frame="4" 
			max_distance="500" 
			name="sprite_invisible" 
			on_finished="0" 
			probability="1" >

		</Event>

		<Event 
			check_physics_material="0" 
			frame="0" 
			max_distance="500" 
			name="sprite_visible" 
			on_finished="1" 
			probability="1" >

		</Event>

		<Event 
			check_physics_material="0" 
			frame="0" 
			max_distance="500" 
			name="throw" 
			on_finished="0" 
			probability="1" >

		</Event>
	</RectAnimation>


	<RectAnimation 
		frame_count="4" 
		frame_height="16" 
		frame_wait="0.002" 
		frame_width="19" 
		frames_per_row="4" 
		
		name="thrust_left" 
		pos_x="0" 
		pos_y="16" >
	</RectAnimation>

	<RectAnimation 
		frame_count="4" 
		frame_height="16" 
		frame_wait="0.002" 
		frame_width="19" 
		frames_per_row="4" 
		
		name="thrust_right" 
		pos_x="0" 
		pos_y="32" >
	</RectAnimation>

	<RectAnimation 
		frame_count="4" 
		frame_height="16" 
		frame_wait="0.002" 
		frame_width="19" 
		frames_per_row="4" 
		
		name="thrust_both" 
		pos_x="0" 
		pos_y="0" >
	</RectAnimation>

	<Hotspot 
		color="00ff0000" 
		name="hand" >
	</Hotspot>


</Sprite>

